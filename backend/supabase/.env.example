# =============================================================================
# Constellation Self-Hosted Supabase Environment Configuration (.env)
# =============================================================================
# PRODUCTION INSTRUCTIONS:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Generate secure 32+ character secrets (NEVER use default values in production):
#    - JWT_SECRET: Run `openssl rand -hex 32`
#    - POSTGRES_PASSWORD: Run `openssl rand -base64 24`
# 3. Generate ANON_KEY and SERVICE_ROLE_KEY using standard HS256 JWT tokens:
#    - Header: {"alg": "HS256", "typ": "JWT"}
#    - Anon Payload: {"role": "anon", "iss": "supabase", "iat": 1727198400, "exp": 1885000000}
#    - Service Payload: {"role": "service_role", "iss": "supabase", "iat": 1727198400, "exp": 1885000000}
#    - Sign using your generated JWT_SECRET.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database Credentials & Connectivity
# -----------------------------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_PASSWORD=replace_with_super_secret_pg_password_32_chars
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# JWT & API Keys Authentication
# -----------------------------------------------------------------------------
# Secret used by GoTrue, PostgREST, Realtime, and Storage to sign/verify JWT tokens
JWT_SECRET=replace_with_at_least_32_character_hex_random_secret_now
JWT_EXPIRY=3600

# Public Anonymous API Key (used by mobile/web clients in Authorization: Bearer <ANON_KEY>)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace_with_signed_anon_token

# Administrative Service Role Key (bypasses RLS - NEVER expose to Flutter/Web client!)
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace_with_signed_service_role_token

# -----------------------------------------------------------------------------
# Public Service Endpoints & Network Ports
# -----------------------------------------------------------------------------
# The externally reachable URL of Kong API gateway (e.g., https://api.yourdomain.com on VPS)
API_EXTERNAL_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000
SITE_URL=http://localhost:3000

# Additional redirect URLs for OAuth / deep linking (comma separated)
ADDITIONAL_REDIRECT_URLS=https://localhost:3000,constellation://auth-callback

# Local host binding ports
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
STUDIO_PORT=3000

# -----------------------------------------------------------------------------
# Supabase Auth (GoTrue) Policies
# -----------------------------------------------------------------------------
# Set to true to disable public user registration if running a closed circle
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true

# Set to true for local testing without SMTP server (auto-confirms email on register)
# In production, set to false and configure SMTP settings below!
ENABLE_EMAIL_AUTOCONFIRM=true

# SMTP Mail Delivery Settings (Production)
SMTP_ADMIN_EMAIL=admin@constellation.internal
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME="Constellation Security"

# -----------------------------------------------------------------------------
# Storage Engine Backend
# -----------------------------------------------------------------------------
# Default: Local VPS disk storage (mapped to ./volumes/storage)
STORAGE_BACKEND=file
FILE_SIZE_LIMIT=52428800

# Optional: Cloudflare R2 / AWS S3 compatibility (if STORAGE_BACKEND=s3)
# GLOBAL_S3_BUCKET=
# STORAGE_S3_REGION=auto
# STORAGE_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_S3_KEY=
# STORAGE_S3_SECRET=
